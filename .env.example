DJANGO_SECRET_KEY=replace-with-secure-key-abcdefghijklmnopqrstuvwxyz-1234567890
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Use the pooled connection string from Neon; keep this value secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Set to the origin(s) of your Next.js app, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
